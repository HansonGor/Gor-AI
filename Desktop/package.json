{
  "name": "gor-desktop",
  "productName": "Gor",
  "version": "0.1.0",
  "description": "Gor 桌面端：用 Electron 承载现有 Web 前端（普通会话，与 Web 共用）",
  "private": true,
  "main": "out/main.js",
  "scripts": {
    "compile": "tsc -p ./",
    "build:web": "npm --prefix ../Web run build",
    "start": "npm run compile && electron .",
    "dev": "node scripts/dev.mjs",
    "test": "npm run compile && node --test",
    "dist": "npm run build:web && npm run compile && electron-builder --win"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "electron": "44.9.3",
    "electron-builder": "26.17.0",
    "typescript": "5.9.3"
  },
  "build": {
    "appId": "com.gor.desktop",
    "productName": "Gor",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../Web/dist",
        "to": "web"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "../Web/public/icon-512.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Gor"
    }
  }
}
