{
  "name": "gor-vscode",
  "displayName": "Gor",
  "description": "Connect VS Code to Gor Server.",
  "version": "0.1.0",
  "publisher": "gor",
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:gor.reconnect",
    "onCommand:gor.openChat"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "gor.reconnect",
        "title": "Gor: Reconnect"
      },
      {
        "command": "gor.openChat",
        "title": "Gor: Open Chat"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "gor",
          "title": "Gor",
          "icon": "resources/gor-activity.png"
        }
      ]
    },
    "views": {
      "gor": [
        {
          "type": "webview",
          "id": "gor.chatView",
          "name": "Gor Chat"
        }
      ]
    },
    "configuration": {
      "title": "Gor",
      "properties": {
        "gor.serverUrl": {
          "type": "string",
          "default": "ws://localhost:3001/ws/vscode",
          "description": "Gor Server WebSocket URL."
        },
        "gor.httpBaseUrl": {
          "type": "string",
          "default": "http://localhost:3001",
          "description": "Base HTTP URL for Gor chat APIs."
        },
        "gor.toolchain.revealOutput": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "施行命令时自动把「输出」面板切换到「Gor 工具链」，显示完整输出（不抢编辑器焦点）。"
        },
        "gor.toolchain.allowlist": {
          "type": "array",
          "items": { "type": "string" },
          "default": [
            "node:env", "node:test", "node:typecheck", "node:lint",
            "node:run_script:build", "node:run_script:test", "node:run_script:lint", "node:run_script:typecheck",
            "git:status", "git:diff", "git:log", "git:fetch",
            "python:env", "python:test", "python:lint", "python:typecheck", "python:format_check"
          ],
          "markdownDescription": "审阅落笔模式下也直接运行的操作（白名单）。格式为 `工具链:动作` 或 `node:run_script:脚本名`，可用 `*` 结尾匹配一类，例如 `node:run_script:*`。删除类、项目外和疑似风险的操作不受白名单影响，始终需要确认。"
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "npm run compile && node --test",
    "build:webview": "npm --prefix ../Web run build:extension",
    "watch:webview": "node ./scripts/watch-webview.mjs",
    "vscode:prepublish": "npm run build:webview && npm run compile"
  },
  "dependencies": {
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "@types/vscode": "^1.85.0",
    "@types/ws": "^8.18.1",
    "typescript": "^5.8.3"
  }
}
