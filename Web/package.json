{
  "name": "langchain-agent-client",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "test:code": "node --test scripts/code-highlight.test.mjs scripts/vscode-code-highlight.test.mjs",
    "test:share": "node --test scripts/share.test.mjs scripts/share-export.test.mjs",
    "test:thinking": "node --test scripts/thinking.test.mjs",
    "test:message-error": "node --experimental-strip-types --test scripts/chat-message-error.test.ts",
    "predev": "vite build --config vite.preview-runtime.config.js",
    "dev": "vite",
    "prebuild": "vite build --config vite.preview-runtime.config.js",
    "build": "vite build",
    "build:vscode": "vite build --config vite.vscode.config.js",
    "build:extension": "npm run build:preview-runtime && npm run build:vscode",
    "build:preview-runtime": "vite build --config vite.preview-runtime.config.js",
    "test:preview": "node --experimental-strip-types --test scripts/preview-core.test.ts scripts/preview-message-ui.test.mjs",
    "test:diff": "node --experimental-strip-types --test scripts/diff-presentation.test.ts scripts/code-diff-ui.test.mjs",
    "test:session": "node --test scripts/session-resume.test.mjs",
    "test:composer": "node --test scripts/file-edit-mode-ui.test.mjs scripts/thinking-mode-ui.test.mjs scripts/model-selector-ui.test.mjs",
    "test:toolchain": "node --test scripts/toolchain-run-ui.test.mjs",
    "test:account": "node --test scripts/account-ui.test.mjs",
    "test:sync": "node --test scripts/chat-sync.test.mjs",
    "preview": "vite preview",
    "format": "prettier --write \"src/**/*.{ts,tsx,less,css,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,less,css,json}\""
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "autoprefixer": "^10.5.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "esbuild-wasm": "^0.25.12",
    "fflate": "0.8.3",
    "html-to-image": "^1.11.13",
    "lucide-react": "^1.41.0",
    "pinyin-pro": "^3.29.3",
    "postcss": "^8.5.28",
    "react": "^18.3.1",
    "react-diff-view": "^3.3.3",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.3",
    "remark-gfm": "^4.0.1",
    "shiki": "^3.23.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^3.4.19",
    "three": "0.186.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^30.1.2",
    "less": "^4.2.1",
    "prettier": "^3.9.6",
    "typescript": "^5.7.0",
    "vite": "^5.4.11"
  }
}
