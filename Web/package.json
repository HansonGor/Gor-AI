{
  "name": "langchain-agent-client",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "predev": "vite build --config vite.preview-runtime.config.js",
    "dev": "vite",
    "prebuild": "vite build --config vite.preview-runtime.config.js",
    "build": "vite build",
    "build:vscode": "vite build --config vite.vscode.config.js",
    "build:extension": "npm run build:preview-runtime && npm run build:vscode",
    "build:preview-runtime": "vite build --config vite.preview-runtime.config.js",
    "test:preview": "node --experimental-strip-types --test scripts/preview-core.test.ts",
    "preview": "vite preview",
    "format": "prettier --write \"src/**/*.{ts,tsx,less,css,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,less,css,json}\""
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "autoprefixer": "^10.5.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "esbuild-wasm": "^0.25.12",
    "fflate": "0.8.3",
    "lucide-react": "^1.41.0",
    "pinyin-pro": "^3.29.3",
    "postcss": "^8.5.28",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.3",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^3.4.19",
    "three": "0.186.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "^4.3.4",
    "less": "^4.2.1",
    "prettier": "^3.9.6",
    "typescript": "^5.7.0",
    "vite": "^5.4.11"
  }
}
