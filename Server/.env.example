# 火山引擎方舟
ARK_API_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_API_KEY=your-ark-api-key
ARK_MODEL_ID=deepseek-v4-pro
# 单次输出上限（含工具参数）；复杂场景建议 16384，需模型支持。限制范围 1024–32768。
ARK_MAX_OUTPUT_TOKENS=16384
ARK_VISION_MODEL_ID=doubao-seed-2.0-1ite
# 模型选择器中额外可选的模型（JSON 数组，可选）；默认模型始终是 ARK_MODEL_ID
# GOR_EXTRA_MODELS=[{"id":"ep-你的接入点","name":"DeepSeek V4 Pro","description":"更强推理，较慢"}]

# 多搜索引擎（缺哪个 key 哪个源就自动跳过）
# 豆包网页搜索（FeedCoop / 火山引擎）
DOUBAO_SEARCH_API_KEY=
# Tavily 通用搜索（https://tavily.com）
TAVILY_API_KEY=tvly-xxx
# 博查 Web Search（https://open.bochaai.com）
BOCHA_API_KEY=sk-0ce699560efe4208a95b69748165824f
# Serper Google 搜索代理（https://serper.dev，海外/中英文资料）
SERPER_API_KEY=
# Brave Search（https://brave.com/search/api，独立索引）
BRAVE_API_KEY=
# Exa 语义搜索（https://exa.ai，深度技术调研）
EXA_API_KEY=
# GitHub Token（https://github.com/settings/tokens，Code Search 必须鉴权，public_repo 权限即可）
GITHUB_TOKEN=

# 小云雀视频生成
XIAOYUNQUE_AK=your-xiaoyunque-ak
XIAOYUNQUE_SK=your-xiaoyunque-sk

# 阿里云百炼 Embedding
DASHSCOPE_API_KEY=your-dashscope-api-key
EMBEDDING_BASE_URL=https://ws-j6rynkso15yxx2da.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=qwen3.7-text-embedding

# Supabase 数据库
SUPABASE_DB_URL=postgresql://postgres:password@db.example.supabase.co:5432/postgres

# 生产环境请把此目录映射到持久化卷（多实例时使用共享卷）。
# 保存用户附件和助手生成的文件；否则容器重建后本地文件系统可能被清空。
GOR_STORAGE_DIR=./storage

# 服务配置
PORT=3001
CLIENT_ORIGIN=http://localhost:5173
JUDGE0_URL=http://localhost:2358
# AI 可访问的 Web 工作区；默认为本项目的 Web 目录
# PROJECT_WORKSPACE_ROOT=D:/Gor/Web

# Agent 配置
AGENT_MAX_ITERATIONS=5
AGENT_TYPING_CHUNK_SIZE=5
AGENT_TYPING_DELAY_MS=20

# 高德地图 Web 服务 Key（逆地理编码 + 天气查询）
AMAP_WEB_SERVICE_KEY=your-amap-web-service-key

# Pexels API（可用于独立图片搜索，也用于 PPT 内容配图）
PEXELS_API_KEY=

# 图片搜索 Provider（不需要密钥的 Openverse/Wikimedia 默认也会参与）
PIXABAY_API_KEY=
UNSPLASH_ACCESS_KEY=
